PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ai_task_platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
STALE_TASK_TIMEOUT_MINUTES=5
FRONTEND_URL=http://localhost:3000

# Gmail SMTP for password reset emails - see backend/src/utils/mailer.ts for
# how to generate an App Password (regular Gmail password will NOT work)
GMAIL_USER=
GMAIL_APP_PASSWORD=
