# Credentials for docker-compose.yml's local Mongo/Redis containers only.
# Copy to .env and fill in real values - never commit the real .env.
# Generate strong values with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_string
MONGO_APP_USER=ai_task_platform_app
MONGO_APP_PASSWORD=replace_with_a_long_random_string
REDIS_PASSWORD=replace_with_a_long_random_string
